PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=leadgen
DB_USER=root
DB_PASSWORD=your_password

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Admin login (Model Maintenance, Source Registry). Never commit a real value.
# Without it, db:init creates the admin with login disabled; then run
# ADMIN_PASSWORD=... npm run admin:set-password
# ADMIN_PASSWORD=

# Cloud SQL only: when set, connects over the Unix socket and DB_HOST/DB_PORT are ignored.
# DB_SOCKET=/cloudsql/PROJECT:REGION:INSTANCE

# Comma-separated extra browser origins allowed by CORS (deployed frontend).
# CORS_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com

# LLM provider: "gemini" (default for deployment) or "ollama" (local fallback).
LLM_PROVIDER=gemini

# Gemini — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: lower thinking = faster, cheaper answers on Gemini 3 models.
# GEMINI_THINKING_LEVEL=low
# Optional: US$ per million tokens for the model in use; enables cost figures
# in Settings -> AI Configuration (GET /api/ai/usage).
# GEMINI_PRICE_INPUT_USD_PER_MTOK=
# GEMINI_PRICE_OUTPUT_USD_PER_MTOK=

# Ollama fallback (only used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=gemma3
